<?xml version="1.0" encoding="utf-8"?>
<!-- 选择递归深度 BottomSheet：单选 + 记住为默认 + 开始播放 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:paddingBottom="28dp"
    android:background="@color/surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/depth_title"
        android:textColor="@color/onSurface"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/depthGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton android:id="@+id/depthCurrent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/depth_current" android:textColor="@color/onSurface" android:paddingVertical="6dp" />
        <RadioButton android:id="@+id/depthLevel1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/depth_level1" android:textColor="@color/onSurface" android:paddingVertical="6dp" />
        <RadioButton android:id="@+id/depthLevel2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/depth_level2" android:textColor="@color/onSurface" android:paddingVertical="6dp" />
        <RadioButton android:id="@+id/depthLevel3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/depth_level3" android:textColor="@color/onSurface" android:paddingVertical="6dp" />
        <RadioButton android:id="@+id/depthLevel5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/depth_level5" android:textColor="@color/onSurface" android:paddingVertical="6dp" />
        <RadioButton android:id="@+id/depthAll" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/depth_all" android:textColor="@color/onSurface" android:paddingVertical="6dp" />
    </RadioGroup>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/chkSetDefault"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/depth_set_default"
        android:textColor="@color/onSurface" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartScan"
        style="@style/Widget.Yunpan.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/depth_confirm"
        app:backgroundTint="@color/primary"
        android:textColor="@color/onPrimary" />

</LinearLayout>
