<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图标前景：朱砂印章 + 白色听符（古籍风 v1.3）。
     直接按 108 viewport 绘制，去掉旧的 scale/translate hack，杜绝自适应图标堆叠/裁切走样。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 印章外框（圆角方框，白描） -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:pathData="M36,36 L72,36 Q76,36 76,40 L76,60 Q76,64 72,64 L36,64 Q32,64 32,60 L32,40 Q32,36 36,36 Z" />

    <!-- 白色耳机（书卷听书意象） -->
    <group
        android:scaleX="1.75"
        android:scaleY="1.75"
        android:translateX="33"
        android:translateY="31">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M12,3C7.03,3 3,7.03 3,12v6c0,1.66 1.34,3 3,3h3v-8H5.14C5.6,8.18 8.46,5 12,5s6.4,3.18 6.86,8H15v8h3c1.66,0 3,-1.34 3,-3v-6c0,-4.97 -4.03,-9 -9,-9z" />
    </group>

    <!-- 印章底横线（名章感） -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M44,72 L64,72" />
</vector>
